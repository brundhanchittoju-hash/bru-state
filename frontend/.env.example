# ==============================================================================
# STATE AUDIT AI — Frontend Environment Variables Template
# Copy to frontend/.env for local configuration or supply via CI/CD build flags.
# ==============================================================================

# Quick Login (Demo Accounts): Must be "false" in production
VITE_ENABLE_DEMO_LOGIN=false

# API Base URL:
# - Set to /api if served behind a reverse proxy routing /api to the backend
# - Set to full origin (e.g. https://api.audit.karnataka.gov.in/api) if on separate origin
VITE_API_URL=/api

