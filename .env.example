# ==============================================================================
# STATE AUDIT AI — Environment Configuration Template (.env.example)
# Copy to backend/.env and frontend/.env respectively for deployment.
# Never commit real secrets or production credentials to version control.
# ==============================================================================

# Application Environment: 'development', 'staging', 'production'
# In production, SECRET_KEY, PUBLIC_BASE_URL, and CORS_ORIGINS are strictly required.
ENVIRONMENT=production
PROJECT_NAME="STATE AUDIT AI"
API_V1_STR=/api

# Database Connection
# SQLite fallback (development only):
# DATABASE_URL=sqlite:///./state_audit.db
# PostgreSQL 15 / Supabase connection (required for staging and production):
DATABASE_URL=postgresql+psycopg2://username:password@host:5432/dbname?sslmode=require

# Cryptographic and JWT Secrets
# REQUIRED in production: Generate using: openssl rand -hex 32
# Startup fails if left empty, matches default fallback, or is shorter than 32 characters.
SECRET_KEY=your-production-secret-key-here-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# File Storage Configuration
# STORAGE_BACKEND: 'local' (local disk storage) or 'supabase' (Supabase Storage bucket)
STORAGE_BACKEND=local
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_BYTES=26214400
# Supabase Storage settings (REQUIRED when STORAGE_BACKEND=supabase)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_STORAGE_BUCKET=audit-documents

# Public URL & CORS Configuration
# REQUIRED in production: URL used for report verification links and QR codes
PUBLIC_BASE_URL=https://audit.karnataka.gov.in
# REQUIRED in production: JSON array or comma-separated list of allowed origins
CORS_ORIGINS=["https://audit.karnataka.gov.in"]

# Security & Content Security Policy (CSP)
# Optional extra CSP directives to loosen or extend policy without code modifications
CSP_EXTRA=""

# Governance & Rate Limiting
DEFAULT_STATE=Karnataka
RATE_LIMIT_PER_MINUTE=600

# Optional LLM Integration (When empty, system operates in statutory template mode)
LLM_API_KEY=

# ==============================================================================
# Frontend Environment Variables (frontend/.env)
# ==============================================================================
# Quick Login Buttons: Set to "true" in local dev to display demo role switcher buttons.
# Defaults to false when missing or in production.
VITE_ENABLE_DEMO_LOGIN=false

# Frontend API Base URL:
# Leave empty or set to /api in local dev to route through Vite proxy.
# Set to full origin in production if frontend and backend are hosted on separate domains.
VITE_API_URL=/api
